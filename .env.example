# Copy this file to .env and fill in real values. Never commit .env — it's
# gitignored on purpose because it holds live secrets (secret key etc).

# --- Supabase (required) ---
# Project Settings → API Keys in the Supabase dashboard (new sb_publishable_/
# sb_secret_ key format).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
# Server-only. Bypasses Row Level Security — never expose to the client or commit it.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# --- Optional integrations ---
# Each of these is optional: every feature that uses one degrades gracefully
# with a clear "not configured" message when the key is missing, so the app
# runs and builds fine without any of them.

# TODO(API_KEY): Google Gemini (https://aistudio.google.com/apikey) — powers
# every AI feature: resume analysis & JD matching (resume.server.ts), mock
# interviews incl. the soft-skills practice mode (interview.server.ts),
# roadmap generation (roadmap.server.ts), and challenge submission
# explanations (challenge-ai.server.ts). Has a free tier. Optional
# GEMINI_MODEL overrides the default "gemini-2.5-flash".
GEMINI_API_KEY=

# TODO(API_KEY): OpenAI Realtime API (https://platform.openai.com/api-keys)
# — powers the live AI voice interview room (src/services/realtime/).
# Requires an OpenAI account with Realtime API access. Optional
# OPENAI_REALTIME_MODEL overrides the default "gpt-realtime".
OPENAI_API_KEY=

# TODO(API_KEY): Judge0 CE via RapidAPI (https://rapidapi.com/judge0-official/api/judge0-ce)
# — powers real code execution (Run/Submit) on the coding challenge workspace
# (src/lib/judge0.server.ts). Without it, challenge submission is unavailable.
JUDGE0_API_KEY=

# TODO(API_KEY): Resend (https://resend.com) — powers transactional email:
# interview scheduling, application status updates, job invitations
# (src/lib/email.server.ts, business-emails.server.ts).
RESEND_API_KEY=
